{
  "name": "lingua-robot",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "npm start",
    "start": "expo start",
    "android": "node scripts/android.cjs",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform web",
    "build:android": "expo export --platform android --output-dir dist-android",
    "build:apk": "node scripts/android.cjs --apk",
    "build:apk-release": "node scripts/android.cjs --release"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-picker/picker": "2.11.1",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-camera": "~17.0.10",
    "expo-font": "~14.0.12",
    "expo-router": "~6.0.0",
    "expo-speech": "~14.0.0",
    "expo-speech-recognition": "^3.0.1",
    "expo-status-bar": "~3.0.0",
    "nativewind": "^4.2.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "^0.2.7",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.12",
    "concurrently": "^9.2.0",
    "sharp": "^0.35.4",
    "typescript": "~5.9.2"
  }
}
